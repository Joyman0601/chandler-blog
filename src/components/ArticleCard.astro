---
interface Props {
  title: string;
  href: string;
  date: Date;
  summary: string;
  tags?: string[];
}

const { title, href, date, summary, tags = [] } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "UTC",
}).format(date);
---

<article class="article-card">
  <time class="article-date" datetime={date.toISOString()}>{formattedDate}</time>
  <div class="article-card-content">
    <h3><a href={href}>{title}</a></h3>
    <p class="summary">{summary}</p>
    {tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => (
          <a class="tag tag-link" href={`/tags/${tag}/`}>{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>
