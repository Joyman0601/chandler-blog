---
import { site } from "../data/site";
---

<aside class="side-panel">
  <div class="profile-head">
    <img class="profile-avatar" src={site.avatar} alt={site.name} width="64" height="64" loading="lazy" decoding="async" />
    <div class="profile-id">
      <h2>{site.name}</h2>
      <span class="profile-realname">{site.tagline}</span>
    </div>
  </div>
  <ul class="profile-list">
    <li>{site.bio}</li>
    <li>
      链接：
      {
        site.links.map((link, index) => (
          <>
            <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
            {index < site.links.length - 1 ? " / " : ""}
          </>
        ))
      }
    </li>
  </ul>
  <a class="text-link profile-about" href="/about/">关于我 <span aria-hidden="true">↗</span></a>
</aside>
