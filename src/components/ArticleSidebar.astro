---
import type { TocEntry, BlogPost } from "../utils/posts";

interface Props {
  toc: TocEntry[];
  seriesLabel?: string;
  seriesPosts?: BlogPost[];
  currentId: string;
}

const { toc, seriesLabel, seriesPosts = [], currentId } = Astro.props;
---

<aside class="article-aside" data-pagefind-ignore>
  {toc.length > 0 && (
    <details class="aside-block article-toc" open>
      <summary>本文目录 <span>{toc.length} 节</span></summary>
      <nav aria-label="本文目录">
        <ul>
          {toc.map((entry) => (
            <li class={entry.depth === 3 ? "toc-sub" : ""}>
              <a href={`#${entry.slug}`} data-toc-link={entry.slug}>{entry.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )}
  {seriesPosts.length > 1 && (
    <details class="aside-block series-toc" open>
      <summary><strong class="series-title-desktop">{seriesLabel ?? "本系列"}</strong><strong class="series-title-mobile">本系列</strong><span>{seriesPosts.length} 篇</span></summary>
      <nav aria-label="本系列目录">
      <p class="series-label-mobile">{seriesLabel}</p>
      <ol>
        {seriesPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}/`}
              aria-current={post.id === currentId ? "page" : undefined}
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ol>
      </nav>
    </details>
  )}
</aside>

<script is:inline>
  (() => {
    const media = window.matchMedia("(max-width: 820px)");
    const details = document.querySelectorAll(".article-aside details");
    const sync = () => details.forEach((item) => { item.open = !media.matches; });
    sync();
    media.addEventListener("change", sync);
  })();
</script>

{toc.length > 0 && (
  <script is:inline>
    (() => {
      const initToc = () => {
        const links = Array.from(document.querySelectorAll("[data-toc-link]"));
        if (!links.length) return;
        const headings = links
          .map((l) => document.getElementById(l.getAttribute("data-toc-link")))
          .filter(Boolean);
        let active = null;
        const setActive = (id) => {
          if (active === id) return;
          active = id;
          links.forEach((l) => {
            const current = l.getAttribute("data-toc-link") === id;
            l.toggleAttribute("data-active", current);
            if (current) l.setAttribute("aria-current", "location");
            else l.removeAttribute("aria-current");
          });
        };
        let pending = false;
        const update = () => {
          pending = false;
          const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
          let current = headings[0];
          for (const heading of headings) {
            if (heading.getClientRects().length && heading.getBoundingClientRect().top <= offset + 2) current = heading;
          }
          if (current) setActive(current.id);
        };
        const schedule = () => {
          if (!pending) { pending = true; requestAnimationFrame(update); }
        };
        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", schedule);
        window.addEventListener("load", schedule);
        document.addEventListener("toggle", schedule, true);
        document.addEventListener("blog:navigation", schedule);
        update();
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initToc, { once: true });
      } else {
        initToc();
      }
    })();
  </script>
)}
