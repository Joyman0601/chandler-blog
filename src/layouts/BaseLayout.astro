---
import "@fontsource/noto-sans-sc/200.css";
import "@fontsource/noto-serif-sc/400.css";
import "../styles/global.css";
import "../styles/minimal.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = site.title,
  description = site.seoDescription,
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title === site.title ? site.title : `${title} | ${site.title}`;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, site.url).toString();
const metaDescription = description || site.seoDescription;
const ogImage = new URL("/og.png", site.url).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={site.keywords.join(", ")} />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f8faff" />
    <title>{pageTitle}</title>
    <style is:inline>
      /* Opt in before pagereveal, including a cold Back navigation. */
      @media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
    </style>
    <script is:inline>
      for (const type of ["pageswap", "pagereveal"]) {
        window.addEventListener(type, (event) => {
          const transition = event.viewTransition;
          if (!transition) return;
          const controller = new AbortController();
          for (const input of ["wheel", "touchstart", "keydown"]) {
            window.addEventListener(input, () => transition.skipTransition(), { passive: true, signal: controller.signal });
          }
          // A browser may skip a transition; that is normal navigation, not an error.
          transition.finished.catch(() => {}).finally(() => controller.abort());
        });
      }
    </script>
    <script is:inline>
      (() => {
        let stored;
        try { stored = localStorage.getItem("theme"); } catch {}
        const dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (dark) document.documentElement.setAttribute("data-theme", "dark");
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label={site.title}>
          <span class="brand-text">
            <span class="brand-name"><span class="brand-latin">{site.name}</span></span>
          </span>
        </a>
        <div class="header-actions">
          <nav class="nav" aria-label="主导航">
            {
              site.nav.map((item) => {
                const isHome = item.href === "/";
                const isCurrent = isHome
                  ? currentPath === item.href
                  : currentPath.startsWith(item.href);
                return (
                  <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
                    {item.label}
                  </a>
                );
              })
            }
          </nav>
          <a class="icon-button search-button" href="/search/" aria-label="搜索文章" aria-current={currentPath.startsWith("/search/") ? "page" : undefined}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
          </a>
          <button
            class="icon-button"
            type="button"
            id="theme-toggle"
            aria-label="切换深浅色"
          >
            <svg class="theme-dark-label" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
            <svg class="theme-light-label" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 14A8.5 8.5 0 0 1 10 4a8.5 8.5 0 1 0 10 10Z" /></svg>
          </button>
        </div>
      </div>
    </header>
    <script is:inline>
      (() => {
        const header = document.querySelector(".site-header");
        if (!header || !("ResizeObserver" in window)) return;
        // Text resizing can make the masthead taller than its CSS minimum.
        const observer = new ResizeObserver(() => {
          document.documentElement.style.setProperty("--header-offset", `${header.getBoundingClientRect().height}px`);
        });
        observer.observe(header);
      })();
    </script>
    {ogType === "article" && <div class="reading-progress" aria-hidden="true"><span id="reading-bar"></span></div>}
    <main class="shell main" id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span class="footer-copyright">© {new Date().getFullYear()} {site.name}</span>
        <div class="footer-meta"><a href={site.links[0].href} target="_blank" rel="noreferrer">GitHub ↗</a><a href="/rss.xml">RSS 订阅</a></div>
      </div>
    </footer>
    <button class="to-top" type="button" id="to-top" aria-label="回到顶部" hidden>↑</button>
    <script is:inline>
      (() => {
        const btn = document.getElementById("to-top");
        if (!btn) return;
        const toggle = () => {
          btn.hidden = window.scrollY < 600;
        };
        toggle();
        window.addEventListener("scroll", toggle, { passive: true });

      })();
    </script>
    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        const syncLabel = () => {
          const dark = document.documentElement.getAttribute("data-theme") === "dark";
          btn.setAttribute("aria-label", dark ? "切换到浅色模式" : "切换到深色模式");
          btn.setAttribute("aria-pressed", String(dark));
        };
        syncLabel();
        btn.addEventListener("click", () => {
          const isDark =
            document.documentElement.getAttribute("data-theme") === "dark";
          if (isDark) {
            document.documentElement.removeAttribute("data-theme");
            try { localStorage.setItem("theme", "light"); } catch {}
          } else {
            document.documentElement.setAttribute("data-theme", "dark");
            try { localStorage.setItem("theme", "dark"); } catch {}
          }
          syncLabel();
        });
      })();
    </script>
    <script>
      import "../scripts/navigation";
    </script>
  </body>
</html>
