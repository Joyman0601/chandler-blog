---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ProfilePanel from "../components/ProfilePanel.astro";
import { site } from "../data/site";
import { siteStats, sortByDateDesc, seriesPostsSorted } from "../utils/posts";

const allPosts = await getCollection("blog");
const sortedPosts = sortByDateDesc(allPosts);
const latestPost = sortedPosts[0];
const posts = sortedPosts.slice(1, 5);
const series = [...new Set(sortedPosts.map((post) => post.data.series).filter(Boolean))]
  .map((key) => {
    const entries = seriesPostsSorted(allPosts, key!);
    return { key, label: entries[0].data.seriesLabel ?? key, entries };
  });
const stats = siteStats(allPosts);
const wordsLabel =
  stats.words >= 10000
    ? `${(stats.words / 10000).toFixed(1)} 万`
    : `${stats.words}`;
---

<BaseLayout>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-intro">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> CHANDLER / 学习手记</p>
      <h1 id="home-title">折腾技术，<br /><span>认真记录。</span></h1>
      <p class="hero-copy">
        {site.bio}<br class="desktop-break" />从 Java 后端到大模型应用，留下能跑起来的代码，和真正想明白的过程。
      </p>
      <div class="link-row">
        <a class="button primary" href="/blog/">翻开笔记 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/about/">认识一下我 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    {latestPost && (
      <article class="featured-note">
        <div class="note-topline"><span>最近的一页</span><time datetime={latestPost.data.pubDate.toISOString()}>{latestPost.data.pubDate.toISOString().slice(0, 10).replaceAll("-", ".")}</time></div>
        <div class="note-mark" aria-hidden="true">“</div>
        <h2><a href={`/blog/${latestPost.id}/`}>{latestPost.data.title}</a></h2>
        <p>{latestPost.data.description}</p>
        <a class="text-link" href={`/blog/${latestPost.id}/`}>继续阅读 <span aria-hidden="true">↗</span></a>
      </article>
    )}
  </section>

  <div class="notebook-strip">
    <p>{site.focus.map((item, index) => <><span>{item}</span>{index < site.focus.length - 1 && <span class="strip-divider" aria-hidden="true">/</span>}</>)}</p>
    <p><strong>{stats.posts}</strong> 篇笔记<span class="strip-divider" aria-hidden="true">·</span>约 <strong>{wordsLabel}</strong> 字</p>
  </div>

  <div class="home-columns">
    <section class="section latest-section" aria-labelledby="latest-title">
      <div class="section-heading">
        <div><p class="section-kicker">THE NOTEBOOK</p><h2 id="latest-title">最近写下的</h2></div>
        <a class="text-link" href="/blog/">全部文章 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="article-list">
        {posts.map((post) => (
          <ArticleCard
            title={post.data.title}
            href={`/blog/${post.id}/`}
            date={post.data.pubDate}
            summary={post.data.description}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>

    <div class="home-aside">
      {series.length > 0 && (
        <section class="series-index" aria-labelledby="series-title">
          <p class="section-kicker">LEARNING IN CHAPTERS</p>
          <h2 id="series-title">沿着一个主题读</h2>
          <p class="aside-intro">把零散的问题，串成一条学习路径。</p>
          <ol>
            {series.map((group, index) => (
              <li><a href={`/blog/#series-${group.key}`}>
                <span class="series-number">{String(index + 1).padStart(2, "0")}</span>
                <span><strong>{group.label}</strong><small>{group.entries.length} 篇笔记</small></span>
                <span class="series-arrow" aria-hidden="true">↗</span>
              </a></li>
            ))}
          </ol>
        </section>
      )}
      <ProfilePanel />
      <a class="rss-note" href="/rss.xml"><span aria-hidden="true">◉</span><span>用 RSS，慢慢读。<small>新文章会出现在你的阅读器里。</small></span><span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">LEARNING BY BUILDING</p><h2>在做，也在记录</h2></div>
      <a class="text-link" href="/projects/">全部项目 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-grid">
      {
        site.projects
          .filter((p) => p.featured)
          .map((project, index) => (
            <article class="project-card">
              <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{project.title}</h3>
              <div class="meta">{project.meta}</div>
              <p class="summary">{project.summary}</p>
              {project.href && (
                <div class="link-row compact">
                  <a class="button" href={project.href} target="_blank" rel="noreferrer">查看源码</a>
                </div>
              )}
            </article>
          ))
      }
    </div>
  </section>
</BaseLayout>
