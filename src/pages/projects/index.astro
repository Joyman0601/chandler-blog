---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProfilePanel from "../../components/ProfilePanel.astro";
import { site } from "../../data/site";
---

<BaseLayout title="项目" description="Chandler 的项目实践，记录个人技术博客、AI 知识库应用和后端工程化探索。">
  <div class="layout">
    <section>
      <h1 class="page-title">项目</h1>
      <div class="grid">
        {
          site.projects.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3>
              <div class="meta">{project.meta}</div>
              <p class="summary">{project.summary}</p>
              {project.details.length > 0 && (
                <ul class="detail-list">
                  {project.details.map((d) => <li>{d}</li>)}
                </ul>
              )}
              {project.href && (
                <div class="link-row compact">
                  <a class="button" href={project.href} target="_blank" rel="noreferrer">查看源码</a>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>
    <ProfilePanel />
  </div>
</BaseLayout>
