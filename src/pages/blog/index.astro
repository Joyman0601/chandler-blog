---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ProfilePanel from "../../components/ProfilePanel.astro";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const standalonePosts = allPosts.filter((post) => !post.data.series);

const seriesMap = new Map<string, { label: string; posts: typeof allPosts }>();
for (const post of allPosts) {
  const key = post.data.series;
  if (!key) continue;
  const label = post.data.seriesLabel ?? key;
  if (!seriesMap.has(key)) {
    seriesMap.set(key, { label, posts: [] });
  }
  seriesMap.get(key)!.posts.push(post);
}

const seriesGroups = Array.from(seriesMap.entries())
  .map(([key, value]) => ({
    key,
    label: value.label,
    posts: value.posts,
    latest: value.posts[0]!.data.pubDate.valueOf(),
  }))
  .sort((a, b) => b.latest - a.latest);
---

<BaseLayout title="文章" description="Chandler 的技术文章与学习笔记">
  <div class="layout">
    <section>
      <h1 class="page-title">文章</h1>

      {standalonePosts.length > 0 && (
        <div class="grid">
          {standalonePosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              href={`/blog/${post.id}/`}
              date={post.data.pubDate}
              summary={post.data.description}
              tags={post.data.tags}
            />
          ))}
        </div>
      )}

      {seriesGroups.map((group) => (
        <div class="series-group">
          <div class="series-header">
            <h2>{group.label}</h2>
            <span class="series-count">{group.posts.length} 篇</span>
          </div>
          <div class="grid">
            {group.posts.map((post) => (
              <ArticleCard
                title={post.data.title}
                href={`/blog/${post.id}/`}
                date={post.data.pubDate}
                summary={post.data.description}
                tags={post.data.tags}
              />
            ))}
          </div>
        </div>
      ))}
    </section>
    <ProfilePanel />
  </div>
</BaseLayout>
